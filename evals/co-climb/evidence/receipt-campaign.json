{
  "contract": "User owns expected labels. Positive whole-dollar unit price times item count. Preserve Total: receipt prefix. Numeric display equivalence. Both Python files editable. No paid work, no holdout, no promotion. Two cycles, 80 individual accepts calls max, zero final reserve. One candidate per side. Deterministic native Python, no results cache or retries. Judge by contract agreement; reject a judge that rejects a named valid spelling. Target score is fraction of correct receipts accepted per set. Two baseline controls and two candidate runs per set; spread=max-min.",
  "python": "3.14.9",
  "versions": {
    "G0": {
      "source": "def answer(qty, price):\n    return f'Total: {price:.2f}'\n",
      "sha256": "8c345085f84de63e1703063005f26d0eac3d78486e4dec364c8fccc124913b6d"
    },
    "J0": {
      "source": "def accepts(qty, price, output):\n    return output.startswith('Total: ')\n",
      "sha256": "2700f468290fd910b3e760ad03c864f78495c3b4914904cf15c054e885857498"
    },
    "J1": {
      "source": "import re\n\n\ndef accepts(qty, price, output):\n    amount = re.fullmatch(r'Total: ([0-9]+)(?:\\.0+)?', output)\n    if amount is None:\n        return False\n    whole_dollars = amount.group(1).lstrip('0') or '0'\n    return whole_dollars == str(qty * int(price))\n",
      "sha256": "d31b64c92814f6dd7eeeacd6ab8d6ecb1f2c3a941f0d870e6dc5f03f3261c1f0"
    },
    "G1": {
      "source": "def answer(qty, price):\n    total = qty * int(price)\n    return f'Total: {total}.00'\n",
      "sha256": "e3bab41d032ae7f0476da3607924960f030dc281c34924e3329bb3fe2116ae29"
    }
  },
